# Board-correct sdkconfig for the LilyGo T-Display-P4 (subset of Meck-P4's proven config).
# CONFIG_IDF_EXPERIMENTAL_FEATURES is required to unlock 200MHz HEX PSRAM -- without it the 200M
# choice is rejected and the earlier boots hung. This is the likely missing piece.
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# 80MHz flash: esptool-accepted image-header freq (Meck runs 120M for LCD bandwidth; revisit later).
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_FATFS_LFN_HEAP=y
# Bring-up console on the USB-Serial/JTAG (P4 default primary console).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
